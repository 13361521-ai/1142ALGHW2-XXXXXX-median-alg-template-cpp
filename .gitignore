int test(int a, int b); 
int findGoodChip(int chips[], int n) {
    if (n == 1) return chips[0];

    int newChips[n];
    int idx = 0;

    for (int i = 0; i < n - 1; i += 2) {
        int a = chips[i];
        int b = chips[i+1];

        if (test(a, b) && test(b, a)) {
            newChips[idx++] = a; 
        }
    }


    if (n % 2 == 1)
        newChips[idx++] = chips[n - 1];

    return findGoodChip(newChips, idx);
}
